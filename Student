public class Student extends Person {
    private String studentNumber;
    private String department;
    private int semester;
    private double gpa;

    private String[] enrolledCourses;
    private int courseCount;

    public Student(String id, String name, String email, String phoneNumber,
                   String studentNumber, String department, int semester) {
        super(id, name, email, phoneNumber);
        this.studentNumber = studentNumber;
        this.department = department;
        this.semester = semester;
        this.gpa = 0.0;
        this.enrolledCourses = new String[10]; // Maximum 10 courses
        this.courseCount = 0;
    }

    public Student(String id, String name, String studentNumber, String department) {
        super(id, name);
        this.studentNumber = studentNumber;
        this.department = department;
        this.semester = 1;
        this.gpa = 0.0;
        this.enrolledCourses = new String[10];
        this.courseCount = 0;
    }

    public String getStudentNumber() {
        return studentNumber;
    }

    public void setStudentNumber(String studentNumber) {
        this.studentNumber = studentNumber;
    }

    public String getDepartment() {
        return department;
    }

    public void setDepartment(String department) {
        this.department = department;
    }

    public int getSemester() {
        return semester;
    }

    public void setSemester(int semester) {
        this.semester = semester;
    }

    public double getGpa() {
        return gpa;
    }

    public void setGpa(double gpa) {
        this.gpa = gpa;
    }

    public String[] getEnrolledCourses() {
        return enrolledCourses;
    }

    public int getCourseCount() {
        return courseCount;
    }

    public boolean addCourse(String courseCode) {
        enrolledCourses[courseCount] = courseCode;
        courseCount++;
        return true;
    }

    public boolean removeCourse(String courseCode) {
        boolean found = false;
        int i = 0;
        int j = 0;

        while (i < courseCount) {
            if (!enrolledCourses[i].equals(courseCode)) {
                enrolledCourses[j] = enrolledCourses[i];
                j++;
            } else {
                found = true;
            }
            i++;
        }

        if (found) {
            courseCount = j;
            enrolledCourses[j] = null;
        }
        return found;
    }

    public String getRole() {
        return "Student";
    }

    public void displayInfo() {
        System.out.println("=== "+getName()+ " Information ===");
        System.out.println("ID: " + getId());
        System.out.println("Name: " + getName());
        System.out.println("Student Number: " + studentNumber);
        System.out.println("Department: " + department);
        System.out.println("Semester: " + semester);
        System.out.println("GPA: " + gpa);
        System.out.println("Contact: " + getContactInfo());
    }

    public String getContactInfo() {
        return super.getContactInfo() + ", Student No: " + studentNumber;
    }
}
